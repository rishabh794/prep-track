# PrepTrack Environment Variables

# NeonDB / PostgreSQL Credentials
# NeonDB URL format: jdbc:postgresql://<endpoint-id>.neon.tech/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/preptrack
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# JWT Security
JWT_SECRET=your-32-byte-or-longer-secret-key-goes-here-minimum-256-bits
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAI API Key (used in Phase 5 for Recall Grading & Debrief)
OPENAI_API_KEY=
